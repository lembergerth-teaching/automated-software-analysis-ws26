{
  "image": "ghcr.io/lembergerth-teaching/automated-software-analysis-ws26:latest",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-vscode.cpptools"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/jupyter/bin/python",
        "jupyter.notebookFileRoot": "${fileDirname}"
      }
    }
  }
}
